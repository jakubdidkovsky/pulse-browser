{
  "name": "pulse-browser",
  "productName": "Pulse",
  "version": "1.0.0",
  "description": "Chromium-based browser with a built-in AI sidebar, groups, pins and history.",
  "main": "main.js",
  "author": "Jakub Didkovsky",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/jakubdidkovsky/pulse-browser",
  "repository": {
    "type": "git",
    "url": "https://github.com/jakubdidkovsky/pulse-browser.git"
  },
  "scripts": {
    "start": "node scripts/start.js",
    "test": "node --test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON",
    "postinstall": "node node_modules/electron/install.js",
    "fix-sandbox": "sudo chown root:root node_modules/electron/dist/chrome-sandbox && sudo chmod 4755 node_modules/electron/dist/chrome-sandbox",
    "install-desktop": "node scripts/install-desktop.js",
    "dist": "electron-builder --publish never",
    "dist:linux": "electron-builder --linux --x64 --arm64 --publish never",
    "dist:win": "electron-builder --win --x64 --publish never && electron-builder --win --arm64 --publish never"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@dagrejs/dagre": "3.1.1",
    "@duckduckgo/autoconsent": "^17.1.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@ghostery/adblocker-electron": "2.20.1",
    "dompurify": "^3.4.17",
    "electron-chrome-extensions": "^4.10.0",
    "electron-chrome-web-store": "^0.13.0",
    "marked": "^18.1.2",
    "qrcode-generator": "^2.0.4"
  },
  "overrides": {
    "@ghostery/adblocker": "2.20.1",
    "@ghostery/adblocker-electron-preload": "2.20.1",
    "@ghostery/adblocker-content": "2.20.1",
    "@ghostery/adblocker-extended-selectors": "2.20.1"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "cz.didkovsky.pulse",
    "productName": "Pulse",
    "copyright": "© Jakub Didkovsky",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "remote/**",
      "renderer/**",
      "assets/**",
      "package.json"
    ],
    "npmRebuild": false,
    "win": {
      "icon": "assets/icon.png",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Pulse",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "artifactName": "Pulse-Setup-${arch}.${ext}"
    },
    "toolsets": {
      "appimage": "1.0.3"
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "executableName": "pulse-browser",
      "category": "Network",
      "maintainer": "Jakub Didkovsky <135758282+jakubdidkovsky@users.noreply.github.com>",
      "synopsis": "Browser with a built-in AI agent",
      "mimeTypes": [
        "x-scheme-handler/http",
        "x-scheme-handler/https"
      ],
      "desktop": {
        "entry": {
          "GenericName": "Web Browser",
          "Categories": "Network;WebBrowser;",
          "Keywords": "browser;web;internet;ai;"
        }
      },
      "artifactName": "Pulse-${arch}.${ext}"
    }
  }
}
